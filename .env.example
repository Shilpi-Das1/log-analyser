# ── LLM: Bob Shell (the `bob` CLI) ──
# IBM Bob IDE -> Settings -> API Keys -> Shell / non-interactive
BOBSHELL_API_KEY=
# Optional: bob chat mode. Default "ask" (no file access; the CLI runs in an empty workspace).
# BOB_SHELL_MODE=ask
# Only used by bob 1.x
# BOB_SHELL_MODEL=premium-ide
# Per-call timeout in seconds
LLM_TIMEOUT_S=300

# Optional alternative: OpenAI-compatible HTTP endpoint instead of Bob Shell
# LLM_BACKEND=http
# LLM_API_KEY=
# LLM_API_BASE=https://api.us-east.bob.ibm.com/inference/v1/chat/completions
# LLM_MODEL=premium-ide
# LLM_AUTH_STYLE=auto

# ── Projects: host folder holding one sub-folder per repository (mounted read-only by docker compose) ──
# For `python app.py` set PROJECTS_ROOT instead (default /workspace/projects).
PROJECTS_HOST_PATH=./projects
# PROJECTS_ROOT=./projects

# ── GitHub: token needs repo (or issues + contents + pull_requests) scope ──
GITHUB_TOKEN=
# Fallback repository (owner/name) for projects that do not define their own github_repo
GITHUB_REPO=
# true = never call GitHub's write APIs; returns placeholder URLs (safe for rehearsals)
GITHUB_DRY_RUN=true

# ── Behaviour ──
CONFIDENCE_THRESHOLD=0.6
# Minimum similarity (0-1) for a verified knowledge-base fix to be reused without calling the LLM
KB_MATCH_THRESHOLD=0.8
